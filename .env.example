# ------------------------------------------------------------------------------
# BuildCity — Environment Variables Template
# Copy this file to .env and fill in real values. Never commit .env
# ------------------------------------------------------------------------------

# --- Frontend (Vite) ---
# Development: http://localhost:5000
# Production:  https://buildcity-web.onrender.com
VITE_API_URL=http://localhost:5000

# --- Server ---
PORT=5000
NODE_ENV=development

# Random 64+ char secret for JWT signing
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Comma-separated list of allowed frontend origins for CORS
ALLOWED_ORIGINS=http://localhost:5173

# --- Database (Supabase PostgreSQL) ---
# Pooled connection (port 6543) for runtime queries
DATABASE_URL=
# Direct connection (port 5432) for Prisma migrations and schema pushes
DIRECT_URL=

# --- SMS Gateway (Aradhya Technologies) ---
SMS_USERNAME=
SMS_APIKEY=
SMS_SENDER=
SMS_TEMPLATE_ID=
SMS_PEID=
SMS_ROUTE=TRANS
SMS_TIMEOUT_MS=15000
