{
  "buildCommand": "npm run build",
  "regions": ["bom1"],
  "rewrites": [
    { "source": "/api/sms", "destination": "/api/sms.js" },
    { "source": "/api/v1/:path*", "destination": "https://api.buildcity.cloud/api/v1/:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
