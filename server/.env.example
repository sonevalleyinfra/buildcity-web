# Names only; set real values in the host (Railway/Coolify). Never commit values.

# --- Required ---
# production | staging | test | development. The API exits at boot if it does not match the database marker
# (production/staging: ALTER DATABASE <db> SET buildcity.env = '<env>') or, for test/development, the DB host is not localhost.
APP_ENV=
# Postgres connection string (pooled/app connection)
DATABASE_URL=
# Direct Postgres connection used by `prisma db push` (same as DATABASE_URL without a pooler)
DIRECT_URL=
# Secret for signing JWTs
JWT_SECRET=
# Comma-separated allowed CORS origins
ALLOWED_ORIGINS=http://localhost:5173

# --- Server ---
# Node/library mode only (Dockerfile sets production). Does NOT decide the environment; APP_ENV does.
NODE_ENV=
# Listen port (default 5000)
PORT=5000
# Directory for vendor-fcm-tokens.json (default: server/data). Mount a volume here in Docker (image uses /data).
DATA_DIR=
# Opt-in: base URL to self-ping /health every 8 min (Render free-tier keep-alive). Leave unset elsewhere.
KEEP_ALIVE_URL=

# --- Firebase push (one of) ---
# Path to service account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=
# Inline service account JSON
FIREBASE_SERVICE_ACCOUNT=

# --- SMS (SMS_* are fallbacks for ARADHYA_SMS_*) ---
ARADHYA_SMS_USERNAME=
ARADHYA_SMS_APIKEY=
ARADHYA_SMS_SENDER=
ARADHYA_SMS_TEMPLATE_ID=
ARADHYA_SMS_PE_ID=
ARADHYA_SMS_ROUTE=
SMS_USERNAME=
SMS_APIKEY=
SMS_SENDER=
SMS_TEMPLATE_ID=
SMS_PEID=
SMS_ROUTE=
# Shared secret for the SMS relay
SMS_RELAY_SECRET=
