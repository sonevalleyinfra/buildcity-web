// BuildCity — Prisma ORM Schema for Supabase PostgreSQL
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  VENDOR
  DR
  ADMIN
}

enum VendorStatus {
  PENDING
  APPROVED
  SUSPENDED
}

enum ApprovalStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  COMPLETED
  CANCELLED
}

// 1. User Account Entity
model User {
  id           String   @id @default(uuid())
  phone        String   @unique
  name         String?
  email        String?
  password     String?
  role                Role     @default(CUSTOMER)
  preferredRegionId   String?
  preferredRegionName String?
  cartItems           Json?
  tokenVersion        Int      @default(1)
  status       String   @default("ACTIVE")
  productCount Int      @default(0)
  walletBalance Decimal  @default(0.00)
  referralCode  String?  @unique
  referredBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  vendors    Vendor[]
  drs        DR[]
  addresses  Address[]
  orders     Order[]
  auditLogs  AuditLog[]
  notifications Notification[]
  walletTransactions WalletTransaction[]

  @@index([createdAt, id])
  @@map("users")
}

// 2. OTP Verification Entity
model OTPVerification {
  id        String   @id @default(uuid())
  phone     String
  otp       String
  isVerified Boolean  @default(false)
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone, createdAt])
  @@map("otp_verifications")
}

// 3. Region Zone Entity
model Region {
  id                 String   @id @default(uuid())
  name               String   @unique
  state              String   @default("Uttar Pradesh")
  baseDeliveryCharge Decimal  @default(49.00)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())

  vendors   Vendor[]
  drs       DR[]
  addresses Address[]

  @@map("regions")
}

// 4. District Representative Entity
model DR {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  phone       String
  password    String?
  regionId    String
  region      Region   @relation(fields: [regionId], references: [id])
  status      String   @default("ACTIVE")
  joinedOn    DateTime @default(now())
  // Soft delete: set together with status "DISABLED"; the row and its history stay
  disabledAt  DateTime? @map("disabled_at")

  // Also a partial unique index district_representatives_phone_live_key ON (phone) WHERE disabled_at IS NULL,
  // managed at boot by ensureStaffSchema (src/staff.js): Prisma cannot express partial indexes, so `db push`
  // may drop it and the next boot recreates it.
  @@index([userId])
  @@index([phone])
  @@map("district_representatives")
}

// 5. Vendor Store Profile Entity
model Vendor {
  id             String       @id @default(uuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  shopName       String
  ownerName      String
  phone          String
  password       String?
  regionId       String
  region         Region       @relation(fields: [regionId], references: [id])
  status         VendorStatus @default(PENDING)
  commissionRate Decimal      @default(10.00)
  addedByDr      String?
  joinedOn       DateTime     @default(now())
  // Soft delete: set together with status SUSPENDED (no new enum value, so an old client can still read the row)
  disabledAt     DateTime?    @map("disabled_at")

  vendorProducts VendorProduct[]
  orderItems     OrderItem[]

  // Also a partial unique index vendors_phone_live_key ON (phone) WHERE disabled_at IS NULL, managed at boot by
  // ensureStaffSchema (src/staff.js): Prisma cannot express partial indexes, so `db push` may drop it and the next
  // boot recreates it.
  @@index([userId])
  @@index([phone])
  @@map("vendors")
}

// 6. Master Category Entity
model Category {
  id           String   @id @default(uuid())
  name         String   @unique
  productCount Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  masterProducts ProductMaster[]

  @@map("categories")
}

// 7. Canonical Product Master Entity (Owned by Admin/DR)
model ProductMaster {
  id             String   @id @default(uuid())
  name           String
  categoryId     String
  category       Category @relation(fields: [categoryId], references: [id])
  brand          String   @default("Generic")
  type           String   @default("Standard")
  grade          String   @default("Standard Grade")
  unit           String   @default("Unit")
  suggestedPrice Decimal  @default(100.00)
  imageUrl       String   @default("")
  description    String?
  mrp            Decimal? @default(0)
  customPacks    Json?    @map("custom_packs")
  addedBy        String   @default("Admin")
  createdAt      DateTime @default(now())

  vendorProducts ProductImage[]
  listings       VendorProduct[]

  @@map("product_masters")
}

// 8. Product Image Entity
model ProductImage {
  id              String        @id @default(uuid())
  productMasterId String
  productMaster   ProductMaster @relation(fields: [productMasterId], references: [id], onDelete: Cascade)
  imageUrl        String
  isPrimary       Boolean       @default(true)

  @@map("product_images")
}

// 9. Vendor Store Product Offering (Linked to Product Master)
model VendorProduct {
  id              String         @id @default(uuid())
  masterProductId String
  masterProduct   ProductMaster  @relation(fields: [masterProductId], references: [id], onDelete: Cascade)
  vendorId        String
  vendor          Vendor         @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  regionId        String?
  regionName      String?        @default("Varanasi")
  name            String
  categoryId      String
  categoryName    String
  brand           String
  type            String
  grade           String
  unit            String
  price           Decimal
  mrp             Decimal?       @default(0)
  stockQty        Int            @default(100)
  imageUrl        String
  description     String?
  customPacks     Json?          @map("custom_packs")
  approvalStatus  ApprovalStatus @default(PENDING_REVIEW)
  isActive        Boolean        @default(false)
  addedBy         String         @default("Vendor Catalog Selection")
  submittedOn     DateTime       @default(now())

  orderItems OrderItem[]

  @@index([vendorId])
  @@index([masterProductId])
  @@index([approvalStatus, isActive])
  @@map("vendor_products")
}

// 10. Customer Saved Address Entity
model Address {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  regionId   String
  region     Region   @relation(fields: [regionId], references: [id])
  fullName   String
  phone      String
  street     String
  city       String   @default("Varanasi")
  state      String   @default("Uttar Pradesh")
  pincode    String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  orders Order[]

  @@index([userId])
  @@map("addresses")
}

// 11. Customer Order Entity
model Order {
  id             String      @id @default(uuid())
  orderNumber    String      @unique @default(cuid())
  customerId     String
  customer       User        @relation(fields: [customerId], references: [id])
  addressId      String?
  address        Address?    @relation(fields: [addressId], references: [id])
  totalAmount    Decimal
  deliveryFee    Decimal     @default(49.00)
  discountAmount Decimal     @default(0.00)
  walletDiscount Decimal     @default(0.00)
  cashbackEarned Decimal     @default(0.00)
  couponCode     String?
  paymentMode    String      @default("COD")
  status         OrderStatus @default(PENDING)
  idempotencyKey String?     @unique
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  items   OrderItem[]
  returns OrderReturn[]

  @@index([customerId, createdAt])
  @@index([createdAt, id])
  @@map("orders")
}

// 11b. DR Order Return & Refund Record Entity (Internal DR/Admin Only)
model OrderReturn {
  id               String   @id @default(uuid())
  orderId          String
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  drId             String?
  drPhone          String?
  districtName     String?
  customerPhone    String
  customerName     String?
  returnAmount     Decimal
  cashbackDeducted Decimal  @default(0.00)
  netRefundCash    Decimal
  returnReason     String   @default("Excess / Returned Material")
  returnItems      Json     // [{ itemId, vendorProductId, productName, quantity, price, total, vendorId, vendorName }]
  status           String   @default("COMPLETED")
  createdAt        DateTime @default(now())

  @@index([orderId])
  @@index([customerPhone])
  @@index([createdAt])
  @@map("order_returns")
}

// 12. Order Line Item Entity (Freezes priceAtPurchase)
model OrderItem {
  id              String        @id @default(uuid())
  orderId         String
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendorProductId String?
  vendorProduct   VendorProduct? @relation(fields: [vendorProductId], references: [id])
  vendorId        String
  vendor          Vendor        @relation(fields: [vendorId], references: [id])
  productName     String
  priceAtPurchase Decimal
  cgstAmount      Decimal       @default(0.00)
  sgstAmount      Decimal       @default(0.00)
  quantity        Int
  totalPrice      Decimal

  @@index([orderId])
  @@index([vendorId])
  @@map("order_items")
}

// 13. Audit Log Entity
model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  details   String
  ipAddress String?
  createdAt DateTime @default(now())

  @@map("audit_logs")
}

// 14. Notification Entity
model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  isRead    Boolean  @default(false)
  // Admin broadcast (shown to every customer). Self-provisioned at boot by ensureNotificationSchema (src/notifications.js)
  isBroadcast Boolean @default(false) @map("is_broadcast")
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("notifications")
}

// 15. Coupon Entity
model Coupon {
  id             String   @id @default(uuid())
  code           String   @unique
  title          String
  discountAmount Decimal  @default(100.00)
  minOrder       Decimal  @default(1000.00)
  expiryDate     String?  @default("2026-12-31")
  desc           String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@map("coupons")
}

// 16. Product Review Entity
model Review {
  id        String   @id @default(uuid())
  productId String
  name      String
  rating    Int      @default(5)
  comment   String
  createdAt DateTime @default(now())

  @@index([productId])
  @@map("reviews")
}

// 17. Hero Carousel Banner Entity
model Banner {
  id           String   @id @default(uuid())
  tag          String?  @default("BUILD YOUR DREAM SPACE")
  title        String   @default("Quality Products. Best Prices.")
  imageUrl     String
  targetUrl    String   @default("/categories")
  isActive     Boolean  @default(true)
  displayOrder Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("banners")
}

// 18. Customer Wallet Transaction Entity (Passbook / Ledger)
model WalletTransaction {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Decimal
  type        String   // REFERRAL_BONUS | ORDER_CASHBACK | ORDER_REDEMPTION | ADMIN_ADJUST
  status      String   @default("COMPLETED")
  orderId     String?
  description String
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@map("wallet_transactions")
}

// 19. Application Global Settings (Admin Controlled Wallet & Rewards Configuration)
model AppSetting {
  id                    String   @id @default("wallet_config")
  referralEnabled       Boolean  @default(true)
  cashbackEnabled       Boolean  @default(true)
  cashbackType          String   @default("PERCENTAGE") // PERCENTAGE | FLAT
  cashbackValue         Decimal  @default(2.00)
  minOrderForCashback   Decimal  @default(5000.00)
  maxCashbackCap        Decimal  @default(500.00)
  referralRewardType    String   @default("PERCENTAGE") // PERCENTAGE | FLAT
  referrerReward        Decimal  @default(2.00) // 2% in percentage mode or ₹ in flat mode
  maxReferralRewardCap  Decimal  @default(1000.00)
  refereeRewardType     String   @default("FLAT") // FLAT | PERCENTAGE
  refereeReward         Decimal  @default(50.00)
  walletRedeemEnabled   Boolean  @default(true)
  maxWalletUsagePercent Decimal  @default(10.00)
  maxWalletUsageFlat    Decimal  @default(500.00)
  freeDeliveryEnabled   Boolean  @default(true)
  freeDeliveryMinAmount Decimal  @default(25000.00)
  updatedAt             DateTime @updatedAt

  @@map("app_settings")
}

// 20. Vendor FCM Tokens (Push Notifications)
model VendorFcmToken {
  vendorId  String   @id @map("vendor_id")
  token     String
  phone     String?
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("vendor_fcm_tokens")
}



