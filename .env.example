# ==============================================================================
# BuildCity Web Application — Environment Variables Template
# ==============================================================================
# Copy this file to `.env` (or `server/.env`) and fill in your actual credentials.
# NOTE: Never commit `.env` containing real production secrets to GitHub!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Vite Client)
# ------------------------------------------------------------------------------
# In development (localhost): http://localhost:5000
# In production (Render): https://buildcity-web.onrender.com
VITE_API_URL=http://localhost:5000

# ------------------------------------------------------------------------------
# 2. BACKEND SERVER CONFIGURATION (Express.js)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# Secure random 64+ char secret key for JWT Token signing & verification
JWT_SECRET=your_jwt_super_secret_key_at_least_32_characters_long

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (Supabase PostgreSQL & Prisma ORM)
# ------------------------------------------------------------------------------
# Pooled connection string (Port 6543, pgbouncer=true) for runtime queries
DATABASE_URL=postgresql://postgres.your-project-ref:YourPassword@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Direct connection string (Port 5432) for Prisma migrations & schema pushes
DIRECT_URL=postgresql://postgres.your-project-ref:YourPassword@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
